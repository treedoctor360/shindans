  "rules": [
    {
      "id": "treeNo",
      "type": "treeNoPattern",
      "level": "warn",
      "pattern": "^[A-Z]{2}\\d{3}$",
      "message": "番号の形がいつもと違います。"
    },
    {
      "id": "noTag",
      "type": "statusNotice",
      "level": "info",
      "status": "札なし",
      "message": "番号札のない木です。"
    },
    {
      "id": "maple",
      "type": "speciesNotice",
      "level": "info",
      "pattern": "カエデ",
      "unless": "ミホン",
      "message": "{species}は種名まで記録します。"
    },
    {
      "id": "ratio",
      "type": "ratioAtLeast",
      "level": "warn",
      "items": [
        {
          "ratio": "height",
          "threshold": 60,
          "label": "樹高/幹径"
        },
        {
          "ratio": "branch",
          "threshold": 30,
          "label": "枝長/枝径"
        }
      ],
      "unlessTreat": "縮小",
      "message": "{reasons}。縮小剪定を検討してください。",
      "actions": [
        {
          "type": "addTreat",
          "value": "縮小",
          "label": "処置に縮小剪定を入れる"
        },
        {
          "type": "addNote",
          "value": "比率超過だが剪定不要",
          "label": "剪定不要",
          "dismiss": true
        }
      ]
    },
    {
      "id": "strongFungus",
      "type": "contains",
      "level": "danger",
      "when": {
        "field": "fungus",
        "eq": "有"
      },
      "field": "fungusName",
      "anyOf": [
        "ツヨイタケ",
        "コワイタケ"
      ],
      "message": "{value}に注意してください。"
    },
    {
      "id": "initialConflict",
      "type": "conflict",
      "level": "warn",
      "when": {
        "field": "initialNeeded",
        "eq": "否"
      },
      "hits": [
        {
          "field": "fungus",
          "eq": "有",
          "label": "キノコあり"
        },
        {
          "field": "decay",
          "eq": "有",
          "label": "腐朽あり"
        }
      ],
      "message": "{hits}ですが、詳しい診断が「否」です。"
    },
    {
      "id": "vineCut",
      "type": "noteSuggestsTreat",
      "level": "info",
      "note": "つる巻き付き(切れる)",
      "treat": "つる除去",
      "message": "つるは切れるので、処置に入れられます。",
      "actions": [
        {
          "type": "addTreat",
          "value": "つる除去",
          "label": "処置につる除去を入れる"
        }
      ]
    },
    {
      "id": "noWater",
      "type": "treatForbidden",
      "level": "warn",
      "pattern": "水やり",
      "message": "「水やり」は処置に書きません。"
    },
    {
      "id": "fellReason",
      "type": "treatRequires",
      "level": "danger",
      "pattern": "伐採",
      "field": "fellingReason",
      "label": "伐採理由",
      "message": "伐採の理由を入力してください。"
    },
    {
      "id": "gradeTreat",
      "type": "gradeNeedsTreat",
      "level": "warn",
      "grades": [
        "D"
      ],
      "message": "健全度{grade}ですが処置が空欄です。"
    },
    {
      "id": "photoOver",
      "type": "photoOver",
      "level": "warn",
      "message": "弱点写真は{max}枚までです。"
    }
  ],
